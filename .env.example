# Copy to .env - never commit a real .env
PORT=4000
JWT_SECRET=  # REQUIRED in production, >=32 chars: openssl rand -hex 32 (dev boots with an ephemeral secret if unset)
SCORE_THRESHOLD=80
# Point this at a RUNNING PostgreSQL, or leave DATABASE_URL unset entirely to use the JSON file store.
# A placeholder URL whose server is down no longer breaks the API: it falls back to JSON with a warning (see /health).
DATABASE_URL=postgresql://user:pass@localhost:5432/agentshield
# OpenServ SERV Reasoning - key from https://console.openserv.ai
SERV_API_KEY=
SERV_BASE_URL=https://inference-api.openserv.ai
SERV_MODEL=gpt-5.4-mini
# Reppo Evaluation API - key from https://eval.reppo.xyz (API Key page)
REPPO_API_KEY=
REPPO_BASE_URL=https://eval.reppo.xyz/api/v1
# Current API ("evals", default) settles in ~30-90s. Set legacy only if Reppo restores the old /agents/eval-requests API.
REPPO_API_MODE=evals
REPPO_TASK_TYPE=response
REPPO_DAILY_BUDGET=30      # max evaluations sent to Reppo per rolling 24h (each costs credits)
REPPO_POLL_MS=15000
# REPPO_SETTLEMENT_MINUTES=10  # legacy mode only
CORS_ORIGIN=http://localhost:5173
REPPO_MAX_EVAL_AGE_MS=86400000
VITE_API_URL=
# Cumulative spend limits apply to spend inside this rolling window (hours)
SPEND_WINDOW_HOURS=24
# Abuse / credit protection (all optional; defaults shown)
AUTH_RATE_LIMIT=20        # login+register attempts per IP per 15 min
ACTION_RATE_LIMIT=30      # actions/analyze per account per minute
DAILY_ACTION_CAP=200      # actions per account per 24h
ALLOW_SIGNUP=true         # set to false to close registration (e.g. after judging)
TRUST_PROXY=1             # proxy hops in front of the API (Railway = 1)
