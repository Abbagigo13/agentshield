# Copy to .env — never commit a real .env
PORT=4000
JWT_SECRET=  # REQUIRED in production, >=32 chars: openssl rand -hex 32 (dev boots with an ephemeral secret if unset)
SCORE_THRESHOLD=80
DATABASE_URL=postgresql://user:pass@localhost:5432/agentshield
# OpenServ SERV Reasoning — key from https://console.openserv.ai
SERV_API_KEY=
SERV_BASE_URL=https://inference-api.openserv.ai
SERV_MODEL=gpt-5.4-mini
# Reppo Evaluation API — key from https://eval.reppo.xyz (API Key page)
REPPO_API_KEY=
REPPO_BASE_URL=https://eval.reppo.xyz/api/v1
REPPO_SETTLEMENT_MINUTES=10
CORS_ORIGIN=http://localhost:5173
REPPO_MAX_EVAL_AGE_MS=86400000
VITE_API_URL=
